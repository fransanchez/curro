<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Minimal manifest for SF-0.1 (Gradle skeleton).
        Permissions and additional components are added per-SF (spec §10):
          - RECORD_AUDIO         → SF-2.1
          - READ_CONTACTS        → SF-4.x
          - CALL_PHONE           → SF-4.x
          - BIND_NOTIFICATION_LISTENER_SERVICE → landed in US-030 / SF-4.6
          - POST_NOTIFICATIONS   → SF-3.x
          - QUERY_ALL_PACKAGES   → SF-1.4 (US-012) — landed below; also needed by open_app handler (SF-4.x)
          - INTERNET             → release manifest only (US-008) — see app/src/release/AndroidManifest.xml
          - CATEGORY_HOME        → US-009 (SF-1.1) — landed; see MainActivity intent-filter

        Privacy boundary (spec §12 v1.1):
          This file (src/main) declares NO INTERNET permission. The debug APK has no INTERNET.
          The release overlay (src/release/AndroidManifest.xml) adds INTERNET for telemetry only.
          Firebase Analytics and PostHog also contribute ACCESS_NETWORK_STATE and WAKE_LOCK
          transitively — those are only in the release merged manifest (Q8e-Resolved).
          Audio, transcripts, message content, contacts and aliases NEVER leave the device.
    -->

    <!--
        SF-1.4 (US-012): QUERY_ALL_PACKAGES is required for:
        (a) StaticFavoriteAppsRepositoryImpl to resolve app icons and verify installs.
        (b) InstalledAppsRepositoryImpl (SF-1.5) to enumerate all launchable apps.
        (c) The open_app handler (Phase 4) to find an app by colloquial name.
        Without this permission, PackageManager.getApplicationIcon() and
        queryIntentActivities() return only packages that have visibility rules allowing
        them — most apps would be hidden on Android 11+ (API 30+).
        Curro is a launcher (CATEGORY_HOME) and legitimately needs to see all apps.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        SF-2.1 (US-015): RECORD_AUDIO is required by SystemSttClient (SpeechRecognizer).
        Runtime request is wired in SF-2.3 (US-017) — the launcher screen registers
        rememberLauncherForActivityResult(RequestPermission()) and the ViewModel emits
        LauncherSideEffect.RequestRecordAudio on first mic press. Denial maps to
        CurroError.PermissionDenied → copy_perm_missing_mic.
        The recogniser is configured with EXTRA_PREFER_OFFLINE = true; no INTERNET use.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        SF-3.5 (US-023): foreground service keeping FunctionGemma warm in memory.
        - POST_NOTIFICATIONS (Android 13+) is runtime-optional. If denied the
          service runs without a visible icon — Android 13+ allows this. No
          prompt is requested in Phase 3; Phase 8's config menu may surface it.
        - FOREGROUND_SERVICE is required on Android 9+.
        - FOREGROUND_SERVICE_DATA_SYNC is required on Android 14+ alongside a
          typed `foregroundServiceType`. `dataSync` is the closest semantic match
          for keep-alive of a large in-memory data structure (the LLM weights).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        SF-4.9 (US-033): READ_CONTACTS is required by ContactsContractProvider.
        Runtime request is wired by SF-4.10 (US-034) on first call_contact —
        NEVER at install. Denial maps to CurroError.ReadContactsPermissionMissing
        → copy_perm_missing_contacts.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        SF-4.10 (US-034): CALL_PHONE is required by IntentCallController to fire
        ACTION_CALL directly (spec §6 flow 1: "Llamando a Pepito" — no extra tap).
        Runtime request is wired by the launcher VM on first place-call need.
        Denial maps to CurroError.PermissionDenied → copy_perm_missing_calls.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!--
        SF-4.6 (US-030): BIND_NOTIFICATION_LISTENER_SERVICE allows the system to bind
        CurroNotificationListenerService. This is NOT a runtime permission — the user grants
        it in HyperOS Settings → Apps → Special app access → Notification access. The deep
        link (Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS) is fired by the home CTA.
        tools:ignore="ProtectedPermissions" suppresses the lint warning that this is a
        system-level protected permission (expected for a NotificationListenerService).
    -->
    <uses-permission
        android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!--
        SF-8.7 (US-056) — Opt-in incoming-call assistant mode.

        These three runtime permissions are declared in the manifest but ONLY
        requested at runtime when Fran flips the "Modo asistente de llamadas"
        toggle ON in the config menu. With the toggle OFF (default), Curro
        never asks the user for them AND the InCallService component is
        manifest-disabled (android:enabled="false") below — telephony is 100 %
        native. See IncomingCallModeController for the runtime enable/disable
        path; the toggle-off invariant is verified by
        IncomingCallModeOffInvariantTest.

        BIND_INCALL_SERVICE is the system-only permission required on the
        <service> declaration itself (set via android:permission, NOT a
        <uses-permission>). It is system-granted and does not show in the
        app-info page.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <application
        android:name=".CurroApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Curro">

        <!--
            SF-0.8 (US-008) — A13: Disable Firebase Analytics AdId / GAID collection.
            Curro has no ads, no advertising use case. The AdId permission and collection
            are not appropriate for a single-user home-launcher. Removing this disables
            Google AdId collection even if play-services-ads-identifier is on the classpath.
        -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />        <!-- SF-1.1 (US-009) -->
                <category android:name="android.intent.category.DEFAULT" />     <!-- SF-1.1 (US-009) -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SF-3.5 (US-023): foreground service that keeps FunctionGemma 270M warm in
            memory. exported=false because no external app needs to bind it; the
            CurroApp starts it via ContextCompat.startForegroundService.
            foregroundServiceType="dataSync" is the closest match in Android 14's
            typed-FGS list for "keep a large in-memory data structure synced with
            the process".
        -->
        <service
            android:name=".service.ModelWarmupService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
            SF-4.6 (US-030): notification-listener service. exported=true is required by
            the Android framework — the system binds this service to deliver notification
            events. The android:permission attribute restricts binding to the system only.
        -->
        <service
            android:name=".data.notification.CurroNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            SF-8.7 (US-056): incoming-call assistant service.

            android:enabled="false" is the structural OFF-state: with the toggle off,
            Android's PackageManager treats this service as if it didn't exist, the
            intent-filter is not matched, and the Telecom framework binds the system's
            native InCallService instead. Telephony is 100 % native by default.

            IncomingCallModeController.enable() flips the component to ENABLED via
            PackageManager.setComponentEnabledSetting(..., DONT_KILL_APP); disable()
            reverses it. This is verified by IncomingCallModeOffInvariantTest, which
            asserts that queryIntentServices(Intent("android.telecom.InCallService"))
            does NOT include this component in the OFF state.

            android:exported="true" + android:permission="android.permission.BIND_INCALL_SERVICE"
            is the standard InCallService manifest shape — only the Telecom system service
            (holder of BIND_INCALL_SERVICE) can bind.

            meta-data IN_CALL_SERVICE_UI="false" — Curro does NOT replace the native
            dialer UI. It only speaks an announcement and listens for "sí"/"no". The
            HyperOS call UI continues to render normally.

            foregroundServiceType="phoneCall" is the Android-14+ typed-FGS slot for any
            service active during a call lifecycle.
        -->
        <service
            android:name=".data.telephony.CurroInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:enabled="false"
            android:exported="true"
            android:foregroundServiceType="phoneCall">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

    </application>

</manifest>
