<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Thin theme so the manifest <android:theme="@style/Theme.Curro"> reference resolves.
        Compose drives the actual theming via CurroTheme { }; this XML theme exists only
        so the splash/window theme has somewhere to point.

        SF-0.4 will replace CurroTheme.kt with the real senior-first tokens; this XML
        theme stays as-is (the Compose layer owns the design system, not this file).
    -->
    <!--
        android:windowBackground is set to match LightColors.background (Color.kt) so the
        cold-launch splash frame is invisible when Compose paints its first frame (A12 — Option A).
        The DayNight parent resolves to values-night/colors.xml for dark mode automatically.
        US-005 updates @color/curro_window_background when the real brand palette lands.
    -->
    <style name="Theme.Curro" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/curro_window_background</item>
    </style>
</resources>
