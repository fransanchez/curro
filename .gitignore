google-services.json

# Signing config
signing.properties

# Environment / secrets
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Claude Code memory (personal per developer)
.claude/projects/
.claude/memory/
.kotlin/
Simulator*

# Screenshots for design review
Screenshots/
