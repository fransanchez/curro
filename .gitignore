# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
# "release/" was too broad — it matched app/src/release/ (a source set that belongs in VCS).
# Narrowed to the actual build-output paths Android Studio generates.
app/release/
app/build/outputs/release/

# Gradle files
.gradle/
build/
**/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Google Services (contains API keys)
google-services.json

# Signing config
signing.properties

# Environment / secrets
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Claude Code memory (personal per developer)
.claude/projects/
.claude/memory/
.kotlin/
Simulator*

# Screenshots for design review
Screenshots/

# On-device model weights — sourced locally in `models/`, never committed.
# README.md inside `models/` IS tracked (it documents what goes there + how to push to device).
# US-019 (SF-3.1): the side-loaded `.task` weights also never enter the working tree —
# the defensive `*.task` glob below catches any accidental copy outside `models/`.
*.task
models/*.task
models/*.bin
models/*.tflite
models/*.gguf
